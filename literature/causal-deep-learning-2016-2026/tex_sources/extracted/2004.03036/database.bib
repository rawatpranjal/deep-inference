     jstor_issuetitle = {},
     volume = {54},
     number = {2},
     jstor_formatteddate = {Jun., 1992},
     pages = {pp. 252-259},
     url = {http://www.jstor.org/stable/25050878},
     ISSN = {0581572X},
     abstract = {We consider a class of nonparametric regression estimates introduced by Beran (1981) to estimate quantiles of the conditional distribution functions in the presence of right censoring. Usinge xponential bounds for the oscillation modulus of multivariate empirical processes developed by Stute (1984a), we obtain a Bahadur type representation of kernel type quantile regression estimates.},
