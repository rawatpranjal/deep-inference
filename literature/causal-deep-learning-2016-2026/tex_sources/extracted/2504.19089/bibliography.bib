@phdthesis{LeisnerPhD,
author={Leisner,Christopher J.},
year={2000},
title={Nonlinear wavelet approximation in anisotropic Besov spaces},
journal={ProQuest Dissertations and Theses},
pages={72},
abstract={We introduce new anisotropic wavelet decompositions associated with the smoothness β, β = (β1, …, βd), β 1, …, βd > 0 of multi-dimensional data as measured in anisotropic Besov spaces Bβ. We give the rate of compression of these wavelet decompositions of functions f ∈ Bβ. Finally, we prove that, among a general class of anisotropic wavelet decompositions of a function f ∈ Bβ the anisotropic wavelet decomposition associated with β yields the optimal rate of compression of the wavelet decomposition of f.},
keywords={Pure sciences; Anisotropic; Besov spaces; Nonlinear approximations; Wavelet; Mathematics; 0405:Mathematics},
