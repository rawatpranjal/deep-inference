% Introduce a simple command to define and refer to acronyms and defintions anywhere in the text
\RequirePackage{xifthen}
\RequirePackage{suffix}
\newcounter{mylabelcounter}

\newcommand{\acdef}[2][]{%
	\ifthenelse{\equal{#1}{}}{%
		\refstepcounter{mylabelcounter}#2%
		\immediate\write\@auxout{%
			\string\newlabel{ac:#2}{{1}{\thepage}{{\unexpanded{#2}}}{mylabelcounter.\number\value{mylabelcounter}}{}}%
		}%
	}{%
		\refstepcounter{mylabelcounter}#2 (#1)%
		\immediate\write\@auxout{%
			\string\newlabel{ac:#1}{{1}{\thepage}{{\unexpanded{#1}}}{mylabelcounter.\number\value{mylabelcounter}}{}}%
		}%
	}%
}
\WithSuffix\newcommand\acdef*[2]{%
    \refstepcounter{mylabelcounter}#2%
    \immediate\write\@auxout{%
        \string\newlabel{ac:#1}{{1}{\thepage}{{\unexpanded{#1}}}{mylabelcounter.\number\value{mylabelcounter}}{}}%
    }%
}

\newcommand\ac[1]{\nameref{ac:#1}\xspace}
\WithSuffix\newcommand\ac*[1]{{\hypersetup{linkcolor=black}\nameref{ac:#1}\xspace}}

