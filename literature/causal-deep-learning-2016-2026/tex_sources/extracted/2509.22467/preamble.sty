% Collaborators
\colorlet{alej}{blue}
\colorlet{alba}{darkpink}

\newcommand{\alej}[1]{\textcolor{alej}{\textbf{AA}: #1}}
\newcommand{\alba}[1]{\textcolor{alba}{\textbf{AG}: #1}}

% Add commenting for each collaborator
\newcommandx{\aanote}[2][1=]{\todo[linecolor=alej,backgroundcolor=alej!25,bordercolor=alej,#1]{AA: #2}}
\newcommandx{\agnote}[2][1=]{\todo[linecolor=alba,backgroundcolor=alba!25,bordercolor=alba,#1]{AG: #2}}


% Add important comments (inline)
\newcommandx{\aaimp}[2][1=]{\todo[inline,linecolor=alej,backgroundcolor=alej!25,bordercolor=alej, size=\footnotesize,#1]{AA: #2}}
\newcommandx{\agimp}[2][1=]{\todo[inline,linecolor=alba,backgroundcolor=alba!25,bordercolor=alba, size=\footnotesize,#1]{AG: #2}}

\ifpreamble@debug\else
    \renewcommand{\aanote}[2][1=]{\nop}
	\renewcommand{\aaimp}[2][1=]{\nop}
        \renewcommand{\agnote}[2][1=]{\nop}
	\renewcommand{\agimp}[2][1=]{\nop}
\fi

% \newcommand{\nth}[1]{$#1$-th}
\usepackage{nth} % For things like 2nd, 3rd, etc.
\let\oldnth\nth
\renewcommand{\nth}[1]{%
    \IfInteger{#1}{\oldnth{#1}}{\hbox{#1-th}}%
}  % it does the job
\robustify\nth

% ===================================================================

\newcounter{version}
\setcounter{version}{\preamble@version}

\colorlet{addcolor}{blue}
\colorlet{removecolor}{red}
\colorlet{replacecolor}{orange}

\newcommand{\add}[2]{\ifthenelse{\value{version}=#1}{\textcolor{addcolor}{#2}}{\ifthenelse{\value{version}<#1}{\nop{}}{#2}}}
\newcommand{\remove}[2]{\ifthenelse{\value{version}=#1}{\textcolor{removecolor}{\sout{#2}}}{\ifthenelse{\value{version}<#1}{#2}{\nop{}}}}
\newcommand{\replace}[3]{\ifthenelse{\value{version}=#1}{\textcolor{removecolor}{\sout{#2}} \textcolor{replacecolor}{$\rightarrow$ #3}}{\ifthenelse{\value{version}<#1}{#2}{#3}}}

\AtBeginDocument{\colorlet{defaultcolor}{.}}
\newenvironment{add*}[1]{\ifthenelse{\value{version}=#1}{\color{orange}}{}}{\color{defaultcolor}}

\ifpreamble@verbose
\else
    %% same commands, but show the actual space that the changes take
    \renewcommand{\remove}[2]{\ifthenelse{\value{version}=#1}{\nop{}}{\ifthenelse{\value{version}<#1}{#2}{\nop{}}}}
    \renewcommand{\replace}[3]{\ifthenelse{\value{version}=#1}{\textcolor{replacecolor}{#3}}{\ifthenelse{\value{version}<#1}{#2}{#3}}}
\fi

% Robustifying these commands to use them in captions, headers, etc.
\robustify\add
\robustify\remove
\robustify\replace

% Optional: nicer labels for Input/Output
\algrenewcommand\algorithmicrequire{\textbf{Input:}}
\algrenewcommand\algorithmicensure{\textbf{Output:}}

