archive/data_mnist/
*.npy
*.pkl
*.parquet
*.pt
# Archived simulation-result CSVs (historical, regenerable)
archive/**/*.csv
# Eval stdout dumps (commit only the canonical run referenced in docs)
evals/reports/

# IHDP semi-synthetic data: fetched on demand by exploration/replicate_papers.py
data/external/ihdp/

# DID scoping PDFs: re-fetchable via websource; the markdown conversions are committed
references/did_scoping/*.pdf

# Internal project memory/roadmap and AI project config (never public)
memory.md
roadmap.md
CLAUDE.md
